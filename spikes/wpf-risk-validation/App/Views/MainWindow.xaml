<Window x:Class="PomodoroTimer.Spike.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Timer 2.0 - Technical Preview"
        Width="560" Height="680" MinWidth="420" MinHeight="520"
        FontFamily="Segoe UI Variable" FontSize="14"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">
            <TextBlock Text="Pomodoro Timer 2.0" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="技术预览 · 30 秒验证 · 非正式产品" Margin="0,6,0,24"
                       Foreground="{DynamicResource SecondaryBrush}" />
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" FontSize="18" />
                    <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" FontSize="76"
                               Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Margin="0,12" />
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,0,0,20"
                                 Foreground="{DynamicResource AccentBrush}"
                                 AutomationProperties.Name="测试计时进度" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="开始 (Start)" Command="{Binding StartCommand}"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" />
                        <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" />
                    </WrapPanel>
                    <Button Content="发送测试通知 (Send Test Notification)" Command="{Binding NotifyCommand}" Margin="4,14,4,4" />
                    <Button Content="隐藏到托盘" Command="{Binding HideCommand}" />
                </StackPanel>
            </Border>
            <TextBlock Text="关闭窗口会隐藏到托盘，计时继续。双击托盘图标打开；右键“退出”完全结束。"
                       TextWrapping="Wrap" Margin="0,16,0,12" Foreground="{DynamicResource SecondaryBrush}" />
            <TextBlock Text="{Binding NotificationStatus}" TextWrapping="Wrap" Margin="0,0,0,16" />
            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14">
                <TextBlock Text="{Binding DiagnosticsText}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
